if (-not ('ServiceRow' -as [type])) {
Add-Type -TypeDefinition @'
using System.ComponentModel;
public class ServiceRow : INotifyPropertyChanged {
    public event PropertyChangedEventHandler PropertyChanged;
    void N(string p){ var h = PropertyChanged; if (h != null) h(this, new PropertyChangedEventArgs(p)); }
    bool _sel = true, _pri; string _name = "", _disp = "", _status = "", _start = "", _pid = "";
    public bool   IsSelected  { get { return _sel;    } set { _sel    = value; N("IsSelected");  } }
    public bool   IsPrimary   { get { return _pri;    } set { _pri    = value; N("IsPrimary");   } }
    public string Name        { get { return _name;   } set { _name   = value; N("Name");        } }
    public string DisplayName { get { return _disp;   } set { _disp   = value; N("DisplayName"); } }
    public string Status      { get { return _status; } set { _status = value; N("Status");      } }
    public string StartType   { get { return _start;  } set { _start  = value; N("StartType");   } }
    public string ProcessId   { get { return _pid;    } set { _pid    = value; N("ProcessId");   } }
}
public class ServiceChoice {
    public string Name { get; set; }
    public string DisplayName { get; set; }
    public string State { get; set; }
    public string Label { get { return Name + "   -   " + DisplayName + "   (" + State + ")"; } }
}
'@
}

