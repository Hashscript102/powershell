#Requires -Version 5.1
<#
    Service Restart Console  (WPF version of ServiceRestartDashboard.ps1)

    - Lists your services with live status pills, start type and PID.
    - One service is marked PRIMARY. "Restart ticked (primary first)" restarts the primary,
      waits until it is Running, then restarts everything else that is ticked (order irrelevant).
      If the primary fails or times out, nothing else is touched.
    - If the primary is NOT ticked, the ticked services are simply restarted in grid order.
    - Add / remove services from the UI; the list, primary and computer are saved to
      ServiceRestartConsole.json next to this script, so you never have to edit the script again.
    - Watcher: every 5 s it checks the primary (state change, PID change, or Event ID 7036 in the
      System log). If the primary restarted on its own - crash, recovery action, someone else - a banner
      appears with a "Restart the others now" button, and optionally the ticked services restart
      automatically after a settle period.
    - Works locally or against a remote server (remote needs WinRM / PS remoting).
    - Self-elevates (UAC prompt) because service control needs admin.

    Launch (shortcut):  powershell.exe -ExecutionPolicy Bypass -File "C:\Tools\ServiceRestartConsole.ps1"
#>

# ---------------- Defaults (only used the first time, before the .json exists) ----------------
$DefaultComputer       = $env:COMPUTERNAME           # or 'SERVER01'
$DefaultPrimary        = 'Spooler'                   # <-- the service that must restart FIRST
$DefaultOthers         = @('W32Time', 'BITS')        # <-- the rest; order does not matter
$DefaultTimeoutSeconds = 90
$WatchIntervalSeconds  = 5      # how often the watcher polls the primary
$SettleSeconds         = 10     # after an external primary restart, wait this long before auto-restarting the others
# ----------------------------------------------------------------------------------------------

# --- Self-elevate and make sure we are in an STA thread (WPF needs it) ---
$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(
            [Security.Principal.WindowsBuiltInRole]::Administrator)
$isSta   = [Threading.Thread]::CurrentThread.ApartmentState -eq 'STA'
if (-not $isAdmin -or -not $isSta) {
    $exe      = (Get-Process -Id $PID).Path
    $argLine  = "-NoProfile -ExecutionPolicy Bypass -STA -WindowStyle Hidden -File `"$PSCommandPath`""
    if (-not $isAdmin) { Start-Process -FilePath $exe -ArgumentList $argLine -Verb RunAs }
    else               { Start-Process -FilePath $exe -ArgumentList $argLine }
    exit
}

Add-Type -AssemblyName PresentationFramework, PresentationCore, WindowsBase, System.Xaml

